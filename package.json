{
  "name": "makermesh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:convex": "convex dev",
    "dev:all": "convex dev --start \"npm run dev\"",
    "dev:e2e": "convex dev --start \"npm run build && npm run preview\"",
    "convex:once": "convex dev --once",
    "typecheck": "tsc -b --pretty false && npm run typecheck:convex",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit --pretty false",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "playwright test e2e/visual.spec.ts --project=chromium",
    "social:generate": "playwright test e2e/social.spec.ts --project=chromium",
    "upload:static": "npx @convex-dev/static-hosting upload --build",
    "deploy:static": "npx @convex-dev/static-hosting deploy",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@agentmail/convex": "0.1.0",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/static-hosting": "^0.2.1",
    "@convex-dev/workflow": "^0.4.6",
    "@convex-dev/workpool": "^0.4.10",
    "@firecrawl/firecrawl-convex": "^0.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.123",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "convex-test": "^0.0.56",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "patch-package": "8.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
